{
    "name": "Полный тест всех триггеров Parsec",
    "description": "Проверяет все 10 триггеров: 5, 55, 3, 35, 9, 7, 8, 10, 4, 6. Порядок шагов важен — триггеры 7, 8 требуют наличия карты, 10 — существования персоны.",
    "steps": [
        {
            "id": "org",
            "description": "1) Создать организацию — триггер 5",
            "action": "add_org",
            "params": {
                "name": "TEST-ORG",
                "guid": "{suffix}",
                "parent_guid": "441dc23b-2222-44d2-a999-4190FF028067"
            },
            "expect_ops": [5]
        },
       
        {
            "id": "pep",
            "description": "3) Создать персону в организации — триггер 3",
            "action": "add_person",
            "params": {
                "surname": "Тестов",
                "name": "Иван",
                "patronymic": "Тестович",
                "guid": "{suffix}",
                "org_guid": "{suffix}",
                "tabnum": "T-{suffix}"
            },
            "expect_ops": [3]
        },
        {
            "id": "pep_upd",
            "description": "4) Изменить ФИО персоны — триггер 35",
            "action": "update_person",
            "params": {
                "guid": "{suffix}",
                "surname": "Тестов-Изменённый"
            },
            "expect_ops": [35]
        },
        {
            "id": "card",
            "description": "5) Выдать карту персоне — триггер 9",
            "action": "add_card",
            "params": {
                "pep_guid": "{suffix}",
                "card": "{cardnum}"
            },
            "expect_ops": [9]
        },
        {
            "id": "access",
            "description": "6) Выдать категорию доступа — триггер 7 (требует карты)",
            "action": "add_access",
            "params": {
                "pep_guid": "{suffix}",
                "accessname_id": 64
            },
            "expect_ops": [7]
        },
		 {
            "id": "org_upd",
            "description": "2) Изменить название организации — триггер 55",
            "action": "update_org",
            "params": {
                "guid": "{suffix}",
                "name": "TEST-ORG_RENAMED"
            },
            "expect_ops": [55]
        }
        
    ]
}